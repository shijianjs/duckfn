{
  "name": "duckfn-docs-kit",
  "version": "0.1.1-dev.0",
  "description": "Shared Docusaurus building blocks (TOC toggle, home-page web components, brand tokens, remark version placeholder) for duckfn-family extension docs sites.",
  "license": "MIT",
  "keywords": [
    "duckdb",
    "duckdb-wasm",
    "docusaurus",
    "documentation",
    "web-components",
    "remark",
    "sql"
  ],
  "homepage": "https://shijianjs.github.io/duckfn/docs/docs-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shijianjs/duckfn.git",
    "directory": "duckfn-docs-kit"
  },
  "bugs": {
    "url": "https://github.com/shijianjs/duckfn/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "@visactor/vtable": "^1.26.8",
    "codemirror": "^6.0.2",
    "iconify-icon": "^3.0.3",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=20.0"
  }
}
