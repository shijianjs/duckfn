{
  "name": "duckfn-docs-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared Docusaurus building blocks (TOC toggle, home-page web components, brand tokens, remark version placeholder) for duckfn-family extension docs sites.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-sql": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@duckdb/duckdb-wasm": "^1.30.0",
    "@visactor/vtable": "^1.0.0",
    "codemirror": "^6.0.0",
    "iconify-icon": "^3.0.3",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20.0"
  }
}
