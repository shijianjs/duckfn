# name: test/sql/types/duck_array_table_echo.test
# description: duck_array_table_echo.rs 中 ARRAY 类型（DuckArray<T,N> / [Option<T>; N]）的表函数回显测试
# group: [types]

require rusty_quack

# 关键前提：DuckDB 不支持把 ARRAY 作为表函数的参数值（bind value 无法承载 ARRAY），
# 所以「定型数组」这套表函数统一用等价的 LIST 作入参，再由实现转成定长数组写回 ARRAY 出参，
# 顺便覆盖 to_array 的定长校验分支。真正的 ARRAY 入参只在 array_integer_param 上保留，
# 用来固化「ARRAY 参数不被支持」这一行为。
#
# 行数规则同其它表函数：count 缺省 1，偶数行写值、奇数行写 NULL。

# ============================================================================
# 定型数组入参不被支持（bind value 层面）
# ============================================================================

statement error
SELECT v FROM dfn_table_echo_array_integer_param([1, 2, 3]::INTEGER[3]);
----
Bind value to array type is not supported

# 但 NULL 的 ARRAY 入参（整体为 NULL）可以绑定，回显即 NULL
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_integer_param(NULL::INTEGER[3], count => 2);
----
NULL
NULL

# ============================================================================
# ARRAY(INTEGER, 3) // DuckArray<i32, 3>（入参用 LIST(INTEGER)）
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_integer([1, 2, 3], count => 3);
----
[1, 2, 3]
NULL
[1, 2, 3]

query T
SELECT typeof(v) FROM dfn_table_echo_array_integer([1, 2, 3]);
----
INTEGER[3]

# 长度不足 / 超长 / 空：to_array 在 bind 阶段报错
statement error
SELECT v FROM dfn_table_echo_array_integer([1, 2]);
----
dfn_table_echo_array_integer: expected 3 elements, got 2

statement error
SELECT v FROM dfn_table_echo_array_integer([1, 2, 3, 4]);
----
dfn_table_echo_array_integer: expected 3 elements, got 4

statement error
SELECT v FROM dfn_table_echo_array_integer([]::INTEGER[]);
----
dfn_table_echo_array_integer: expected 3 elements, got 0

# ============================================================================
# ARRAY(BIGINT, 2) // DuckArray<i64, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_bigint([1, 2], count => 2);
----
[1, 2]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_bigint([1, 2]);
----
BIGINT[2]

statement error
SELECT v FROM dfn_table_echo_array_bigint([1]);
----
dfn_table_echo_array_bigint: expected 2 elements, got 1

# ============================================================================
# ARRAY(DOUBLE, 3) // DuckArray<f64, 3>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_double([1.5, -2.25, 0.0], count => 2);
----
[1.5, -2.25, 0.0]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_double([1.5, 2.5, 3.5]);
----
DOUBLE[3]

# ============================================================================
# ARRAY(BOOLEAN, 2) // DuckArray<bool, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_bool([true, false], count => 3);
----
[true, false]
NULL
[true, false]

query T
SELECT typeof(v) FROM dfn_table_echo_array_bool([true, false]);
----
BOOLEAN[2]

# ============================================================================
# ARRAY(VARCHAR, 2) // DuckArray<String, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_varchar(['a', 'bb'], count => 2);
----
[a, bb]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_varchar(['a', 'bb']);
----
VARCHAR[2]

# ============================================================================
# ARRAY(DATE, 2) // DuckArray<DuckDate, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_date([DATE '2024-01-02', DATE '1969-12-31'], count => 2);
----
[2024-01-02, 1969-12-31]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_date([DATE '2024-01-02', DATE '1969-12-31']);
----
DATE[2]

# ============================================================================
# ARRAY(DECIMAL(18,3), 2) // DuckArray<DuckDecimal<18, 3>, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_decimal([1.234, -1.234], count => 2);
----
[1.234, -1.234]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_decimal([1.234, -1.234]);
----
DECIMAL(18,3)[2]

# ============================================================================
# ARRAY(BLOB, 2) // DuckArray<DuckBlob, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_blob(['\xAA\xBB'::BLOB, '\x00\x01\xFF'::BLOB], count => 2);
----
[\xAA\xBB, \x00\x01\xFF]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_blob(['\xAA'::BLOB, ''::BLOB]);
----
BLOB[2]

# 回归：ARRAY 的子向量按 row*N 稠密索引，NULL 行也占着 N 个槽。
# 只置父向量 validity 的话这些槽是未初始化内存，DuckDB 把 ARRAY(BLOB) 转成
# VARCHAR 时会整段转换子向量、把未初始化的 string_t 当指针解引用 —— 全 NULL
# 参数 100% 崩，混 NULL 行约 30%~50% 崩（duckfn/src/value_types/duck_array.rs
# 的 write_null 现在会把子槽一并置 NULL）。
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_blob(NULL, count => 3);
----
NULL
NULL
NULL

# 值行 + NULL 行交替，同样不能崩
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_blob(['\xAA\xBB'::BLOB, '\x00\x01\xFF'::BLOB], count => 4);
----
[\xAA\xBB, \x00\x01\xFF]
NULL
[\xAA\xBB, \x00\x01\xFF]
NULL

# ============================================================================
# ARRAY(ARRAY(INTEGER, 2), 2) // DuckArray<DuckArray<i32, 2>, 2>，嵌套定长数组
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_nested([[1, 2], [3, 4]], count => 2);
----
[[1, 2], [3, 4]]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_nested([[1, 2], [3, 4]]);
----
INTEGER[2][2]

# 内层同样走定长校验
statement error
SELECT v FROM dfn_table_echo_array_nested([[1, 2]]);
----
dfn_table_echo_array_nested: expected 2 elements, got 1

# ============================================================================
# ARRAY(INTEGER, 3) // [Option<i32>; 3]，元素可为 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_integer_n([1, NULL, 3], count => 3);
----
[1, NULL, 3]
NULL
[1, NULL, 3]

query T
SELECT typeof(v) FROM dfn_table_echo_array_integer_n([1, NULL, 3]);
----
INTEGER[3]

# 全 NULL 元素
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_integer_n([NULL, NULL, NULL], count => 1);
----
[NULL, NULL, NULL]

# ============================================================================
# ARRAY(VARCHAR, 2) // [Option<String>; 2]，元素可为 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_varchar_n(['a', NULL], count => 2);
----
[a, NULL]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_varchar_n(['a', NULL]);
----
VARCHAR[2]

# ============================================================================
# ARRAY(DATE, 2) // [Option<DuckDate>; 2]，元素可为 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_date_n([DATE '2024-01-02', NULL], count => 2);
----
[2024-01-02, NULL]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_date_n([DATE '2024-01-02', NULL]);
----
DATE[2]

# ============================================================================
# ARRAY(ARRAY(INTEGER, 2), 2) // [Option<[Option<i32>; 2]>; 2]，外层/内层元素均可为 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_nested_n([[1, NULL], NULL], count => 2);
----
[[1, NULL], NULL]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_array_nested_n([[1, NULL], NULL]);
----
INTEGER[2][2]

# ============================================================================
# 跨 chunk：定长写出后偏移按 idx * N 计算，2048 行之后必须仍然对齐
# ============================================================================

query TT
SELECT CAST(count(*) AS VARCHAR), CAST(count(v) AS VARCHAR)
FROM dfn_table_echo_array_integer([1, 2, 3], count => 3000);
----
3000	1500

query T
SELECT CAST(sum(v[1] + v[2] + v[3]) AS VARCHAR)
FROM dfn_table_echo_array_integer([1, 2, 3], count => 1000);
----
3000

# ============================================================================
# NULL 处理：参数为 NULL 时（值行）回显 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_integer(NULL, count => 2);
----
NULL
NULL

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_array_nested_n(NULL, count => 2);
----
NULL
NULL
