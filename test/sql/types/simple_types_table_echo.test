# name: test/sql/types/simple_types_table_echo.test
# description: simple_types_table_echo.rs 中简单类型的表函数回显测试
# group: [types]

require rusty_quack

# 表函数与标量函数的参数读取机制不同：
#   - 标量函数：参数按行从向量读（DuckValueType::read_valid），NULL 由 validity 决定；
#   - 表函数：参数在 bind 阶段从 duckdb_value 读（read_by_duck_value），
#     结果再按行写回结果向量（本题测的这一侧）。
#
# 行数规则（全部 dfn_table_echo_* 一致）：
#   count 命名参数控制行数，缺省 1、负数按 0；
#   第 0、2、4… 行写出参数值，第 1、3、5… 行写出 NULL。
# 因此下面统一用 count => N 一次覆盖「写值 / 写 NULL」两条写路径。

# ============================================================================
# BOOLEAN (bool)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_bool(true, count => 3);
----
true
NULL
true

query T
SELECT typeof(v) FROM dfn_table_echo_bool(true);
----
BOOLEAN

# ============================================================================
# TINYINT (i8)
# ============================================================================

query I
SELECT v FROM dfn_table_echo_tinyint((-128)::TINYINT, count => 3);
----
-128
NULL
-128

query T
SELECT typeof(v) FROM dfn_table_echo_tinyint(0::TINYINT);
----
TINYINT

# ============================================================================
# SMALLINT (i16)
# ============================================================================

query I
SELECT v FROM dfn_table_echo_smallint((-32768)::SMALLINT, count => 2);
----
-32768
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_smallint(0::SMALLINT);
----
SMALLINT

# ============================================================================
# INTEGER (i32)
# ============================================================================

query I
SELECT v FROM dfn_table_echo_integer(7, count => 4);
----
7
NULL
7
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_integer(0);
----
INTEGER

