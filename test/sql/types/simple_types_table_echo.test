# ============================================================================
# VARCHAR (String)
# ============================================================================

query T
SELECT v FROM dfn_table_echo_varchar('你好 🦆', count => 3);
----
你好 🦆
NULL
你好 🦆

query T
SELECT typeof(v) FROM dfn_table_echo_varchar('a');
----
VARCHAR

# ============================================================================
# 行数规则：count 缺省 1、负数按 0、NULL 等价缺省
# ============================================================================

# 不传 count：单行回显
query I
SELECT count(*) FROM dfn_table_echo_integer(7);
----
1

query I
SELECT v FROM dfn_table_echo_integer(7);
----
7

# count 是命名参数（named_param_from = "count"），不能用位置形式传
statement error
SELECT v FROM dfn_table_echo_integer(5, 3);
----
No function matches

# count => 0 产生空结果集
query I
SELECT count(*) FROM dfn_table_echo_integer(7, count => 0);
----
0

# 负数按 0 处理
query I
SELECT count(*) FROM dfn_table_echo_integer(7, count => -5);
----
0

# count 为 NULL 等价于缺省，回显一行
query I
SELECT count(*) FROM dfn_table_echo_integer(7, count => NULL);
----
1

# 无对应函数的参数类型
statement error
SELECT v FROM dfn_table_echo_integer('x');
----
No function matches

# 未知命名参数在 bind 阶段被 DuckDB 拦下
statement error
SELECT v FROM dfn_table_echo_integer(1, foo => 1);
----
Invalid named parameter "foo"

# 表函数不支持 lateral join 列参数，只能用字面量
statement error
SELECT * FROM range(2) r, dfn_table_echo_integer(r.range);
----
does not support lateral join column parameters

# ============================================================================
# 跨 chunk（vector_size 默认 2048）：行数 > 2048 时不能丢行、串位
# ============================================================================

query TT
SELECT CAST(count(*) AS VARCHAR), CAST(count(v) AS VARCHAR)
FROM dfn_table_echo_integer(7, count => 3000);
----
3000	1500

query T
SELECT CAST(sum(v) AS VARCHAR)
FROM dfn_table_echo_integer(7, count => 3000);
----
10500

query TT
SELECT CAST(count(*) AS VARCHAR), CAST(count(v) AS VARCHAR)
FROM dfn_table_echo_integer(7, count => 2049);
----
2049	1025

# ============================================================================
# NULL 处理：参数为 NULL 时（值行）回显 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_integer(NULL, count => 2);
----
NULL
NULL

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_varchar(NULL, count => 2);
----
NULL
NULL
