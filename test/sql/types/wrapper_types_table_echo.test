# name: test/sql/types/wrapper_types_table_echo.test
# description: wrapper_types_table_echo.rs 中包装类型的表函数回显测试
# group: [types]

require duckfn

# 这些类型的值在 bind 阶段依赖 quack-rs 的 as_timestamp / as_decimal / as_blob 等，
# 与向量读取是两套实现，标量用例覆盖不到，因此单独测表函数这一侧。
#
# 行数规则见 simple_types_table_echo.test：count 缺省 1，偶数行写值、奇数行写 NULL。

# TIMESTAMPTZ 的显示依赖当前时区，固定为 UTC 以保证结果稳定
statement ok
SET TimeZone='UTC';

# ============================================================================
# TIMESTAMP (DuckTimestamp)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timestamp(TIMESTAMP '2024-01-02 03:04:05', count => 3);
----
2024-01-02 03:04:05
NULL
2024-01-02 03:04:05

query T
SELECT typeof(v) FROM dfn_table_echo_timestamp(TIMESTAMP '2024-01-02 03:04:05');
----
TIMESTAMP

# ============================================================================
# TIMESTAMP WITH TIME ZONE (DuckTimestampTz)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timestamptz(TIMESTAMPTZ '2024-01-02 03:04:05+00', count => 2);
----
2024-01-02 03:04:05+00
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_timestamptz(TIMESTAMPTZ '2024-01-02 03:04:05+00');
----
TIMESTAMP WITH TIME ZONE

# ============================================================================
# TIMESTAMP_S (DuckTimestampS)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timestamp_s(TIMESTAMP_S '2024-01-02 03:04:05', count => 2);
----
2024-01-02 03:04:05
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_timestamp_s(TIMESTAMP_S '2024-01-02 03:04:05');
----
TIMESTAMP_S

# ============================================================================
# TIMESTAMP_MS (DuckTimestampMs)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timestamp_ms(TIMESTAMP_MS '2024-01-02 03:04:05.123', count => 2);
----
2024-01-02 03:04:05.123
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_timestamp_ms(TIMESTAMP_MS '2024-01-02 03:04:05.123');
----
TIMESTAMP_MS

# ============================================================================
# TIMESTAMP_NS (DuckTimestampNs)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timestamp_ns(TIMESTAMP_NS '2024-01-02 03:04:05.123456789', count => 2);
----
2024-01-02 03:04:05.123456789
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_timestamp_ns(TIMESTAMP_NS '2024-01-02 03:04:05.123456789');
----
TIMESTAMP_NS

# ============================================================================
# TIME (DuckTime)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_time(TIME '03:04:05.123456', count => 3);
----
03:04:05.123456
NULL
03:04:05.123456

query T
SELECT typeof(v) FROM dfn_table_echo_time(TIME '03:04:05');
----
TIME

# ============================================================================
# TIME_NS (DuckTimeNs)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_time_ns(TIME_NS '03:04:05.123456789', count => 2);
----
03:04:05.123456789
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_time_ns(TIME_NS '03:04:05.123456789');
----
TIME_NS

# ============================================================================
# TIME WITH TIME ZONE (DuckTimeTz)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timetz(TIMETZ '03:04:05+02', count => 2);
----
03:04:05+02
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_timetz(TIMETZ '03:04:05+02');
----
TIME WITH TIME ZONE

# ============================================================================
# DATE (DuckDate)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_date(DATE '2024-01-02', count => 3);
----
2024-01-02
NULL
2024-01-02

# epoch 边界：负天数不应被符号扩展弄坏
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_date(DATE '1969-12-31', count => 1);
----
1969-12-31

query T
SELECT typeof(v) FROM dfn_table_echo_date(DATE '2024-01-02');
----
DATE

# ============================================================================
# DECIMAL(18,3) (DuckDecimal<18, 3>)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_decimal((-1.234)::DECIMAL(18,3), count => 3);
----
-1.234
NULL
-1.234

query T
SELECT typeof(v) FROM dfn_table_echo_decimal(1.234::DECIMAL(18,3));
----
DECIMAL(18,3)

# ============================================================================
# BLOB (DuckBlob)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_blob('\xAA\xBB'::BLOB, count => 2);
----
\xAA\xBB
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_blob('\xAA'::BLOB);
----
BLOB

# ============================================================================
# UUID (DuckUuid)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_uuid('11111111-2222-3333-4444-555555555555'::UUID, count => 2);
----
11111111-2222-3333-4444-555555555555
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_uuid('11111111-2222-3333-4444-555555555555'::UUID);
----
UUID

# ============================================================================
# INTERVAL (DuckInterval: months / days / micros)
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_interval(INTERVAL '1 day 02:03:04', count => 3);
----
1 day 02:03:04
NULL
1 day 02:03:04

# 三个分量都不为 0，验证整体往返
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_interval(INTERVAL '3 months 2 days 01:00:00', count => 1);
----
3 months 2 days 01:00:00

query T
SELECT typeof(v) FROM dfn_table_echo_interval(INTERVAL 1 MONTH);
----
INTERVAL

# ============================================================================
# 跨 chunk：每行都写同一个包装类型值
# ============================================================================

query TT
SELECT CAST(count(*) AS VARCHAR), CAST(count(v) AS VARCHAR)
FROM dfn_table_echo_date(DATE '2024-01-02', count => 3000);
----
3000	1500

# ============================================================================
# NULL 处理：参数为 NULL 时（值行）回显 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_timestamp(NULL, count => 2);
----
NULL
NULL

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_decimal(NULL, count => 2);
----
NULL
NULL

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_uuid(NULL, count => 2);
----
NULL
NULL
