# name: test/sql/types/duck_map_scalar_echo.test
# description: duck_map.rs 中 MAP 类型（IndexMap<K, V> / IndexMap<K, Option<V>>）的 echo 往返测试
# group: [types]

require rusty_quack

# 覆盖 duck_map.rs 的两个实现：
#   IndexMap<K, V>         -> MAP(K, V)，value 不可为 NULL
#   IndexMap<K, Option<V>> -> MAP(K, V)，value 可为 NULL
#
# MAP 在物理上等同 LIST<STRUCT<key, value>>，实现里用 ListVector::reserve/set_entry
# 管理 entry、用 MapVector::get_entry + keys/values 读取，本文件按行/按 entry 两个维度验证。
# 所有取值都用 CAST(... AS VARCHAR) 包一层，避免驱动层对 MAP 的二次转换影响比对。

# ============================================================================
# MAP(VARCHAR, INTEGER) // IndexMap<String, i32>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_integer(map(['a', 'b'], [1, 2])));
----
MAP(VARCHAR, INTEGER)

query T
SELECT CAST(dfn_echo_map_varchar_integer(map(['a', 'b'], [1, 2])) AS VARCHAR);
----
{a=1, b=2}

# IndexMap 保持插入顺序，DuckDB 的 MAP 也保持插入顺序，往返后 key 次序不应变化
query T
SELECT CAST(dfn_echo_map_varchar_integer(map(['b', 'a', 'c'], [3, 1, 2])) AS VARCHAR);
----
{b=3, a=1, c=2}

# 空字符串 key 会被加上引号，中文字符原样保留
query T
SELECT CAST(dfn_echo_map_varchar_integer(map(['', '你好'], [1, 2])) AS VARCHAR);
----
{''=1, 你好=2}

# 按 key 取值，验证 value 真正写进了 MAP 而不是只写了 key
query T
SELECT CAST(dfn_echo_map_varchar_integer(map(['a', 'b'], [1, 2]))['b'] AS VARCHAR);
----
2

query T
SELECT CAST(cardinality(dfn_echo_map_varchar_integer(map(['a', 'b'], [1, 2]))) AS VARCHAR);
----
2

# NULL 行夹在中间时，entry 的 offset 只对非 NULL 行累加，不应影响其它行
query T
SELECT CAST(dfn_echo_map_varchar_integer(i) AS VARCHAR) FROM (VALUES
    (map(['a'], [1])),
    (NULL::MAP(VARCHAR, INTEGER)),
    (map(['b', 'c'], [2, 3]))
) t(i);
----
{a=1}
NULL
{b=2, c=3}

# IndexMap<K, V> 的 value 不可为 NULL：出现 NULL value 时整体返回 NULL
query T
SELECT CAST(dfn_echo_map_varchar_integer(map(['a', 'b'], [1, NULL])) AS VARCHAR);
----
NULL

# ============================================================================
# MAP(INTEGER, VARCHAR) // IndexMap<i32, String>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_integer_varchar(map([1, 2], ['a', 'b'])));
----
MAP(INTEGER, VARCHAR)

query T
SELECT CAST(dfn_echo_map_integer_varchar(map([1, 2], ['a', 'b'])) AS VARCHAR);
----
{1=a, 2=b}

query T
SELECT CAST(dfn_echo_map_integer_varchar(map([1, 2], ['a', NULL])) AS VARCHAR);
----
NULL

# ============================================================================
# MAP(BIGINT, BIGINT) // IndexMap<i64, i64>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_bigint_bigint(map([1::BIGINT], [2::BIGINT])));
----
MAP(BIGINT, BIGINT)

query T
SELECT CAST(dfn_echo_map_bigint_bigint(
    map([1::BIGINT, (-1)::BIGINT], [9223372036854775807::BIGINT, (-9223372036854775808)::BIGINT])
) AS VARCHAR);
----
{1=9223372036854775807, -1=-9223372036854775808}

# ============================================================================
# MAP(INTEGER, DOUBLE) // IndexMap<i32, f64>
#
# 注意：float 只能做 value。duck_map.rs 的 impl 要求 K: Hash + Eq，
# 而 f32/f64 没有实现 Eq，写成 IndexMap<f64, _> 是编译不过的。
# ============================================================================

query T
SELECT typeof(dfn_echo_map_integer_double(map([1, 2], [1.5, -2.25])));
----
MAP(INTEGER, DOUBLE)

query T
SELECT CAST(dfn_echo_map_integer_double(i) AS VARCHAR) FROM (VALUES
    (map([1, 2], [1.5, -2.25])),
    (map([3], [1e308]))
) t(i);
----
{1=1.5, 2=-2.25}
{3=1e+308}

# ============================================================================
# MAP(VARCHAR, DATE) // IndexMap<String, DuckDate>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_date(map(['d'], [DATE '2024-01-02'])));
----
MAP(VARCHAR, DATE)

query T
SELECT CAST(dfn_echo_map_varchar_date(
    map(['d1', 'd2'], [DATE '2024-01-02', DATE '1969-12-31'])
) AS VARCHAR);
----
{d1=2024-01-02, d2=1969-12-31}

# ============================================================================
# MAP(VARCHAR, DECIMAL(18,3)) // IndexMap<String, DuckDecimal<18, 3>>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_decimal(map(['d'], [1.234::DECIMAL(18,3)])));
----
MAP(VARCHAR, DECIMAL(18,3))

query T
SELECT CAST(dfn_echo_map_varchar_decimal(
    map(['d1', 'd2'], [1.234::DECIMAL(18,3), (-1.234)::DECIMAL(18,3)])
) AS VARCHAR);
----
{d1=1.234, d2=-1.234}

# ============================================================================
# MAP(VARCHAR, BLOB) // IndexMap<String, DuckBlob>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_blob(map(['b'], ['\xAA'::BLOB])));
----
MAP(VARCHAR, BLOB)

query T
SELECT CAST(dfn_echo_map_varchar_blob(
    map(['b1', 'b2'], ['\xAA\xBB'::BLOB, ''::BLOB])
) AS VARCHAR);
----
{b1=\xAA\xBB, b2=''}

# 空 BLOB 的 value 内容确实为空
query T
SELECT CAST(octet_length(dfn_echo_map_varchar_blob(map(['b'], [''::BLOB]))['b']) AS VARCHAR);
----
0

# ============================================================================
# MAP(VARCHAR, MAP(VARCHAR, INTEGER)) // IndexMap<String, IndexMap<String, i32>>，嵌套 MAP
# ============================================================================

query T
SELECT typeof(dfn_echo_map_nested(map(['o'], [map(['i'], [1])])));
----
MAP(VARCHAR, MAP(VARCHAR, INTEGER))

query T
SELECT CAST(dfn_echo_map_nested(
    map(['o1', 'o2'], [map(['a', 'b'], [1, 2]), map(['c'], [3])])
) AS VARCHAR);
----
{o1={a=1, b=2}, o2={c=3}}

# 按下标逐层取值
query T
SELECT CAST(dfn_echo_map_nested(map(['o'], [map(['a', 'b'], [1, 2])]))['o']['b'] AS VARCHAR);
----
2

# 内层子 MAP 为 NULL 时，外层整体返回 NULL
query T
SELECT CAST(dfn_echo_map_nested(map(['o'], [NULL::MAP(VARCHAR, INTEGER)])) AS VARCHAR);
----
NULL

# ============================================================================
# MAP(VARCHAR, INTEGER) // IndexMap<String, Option<i32>>，value 可为 NULL
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_integer_n(map(['a'], [1])));
----
MAP(VARCHAR, INTEGER)

query T
SELECT CAST(dfn_echo_map_varchar_integer_n(map(['a', 'b'], [1, NULL])) AS VARCHAR);
----
{a=1, b=NULL}

# 注意：这里必须显式写 NULL::INTEGER。
# 不写类型时 [NULL, NULL] 的物理子向量只有一个元素（常量向量），而 duckfn 的嵌套读取
# 是按下标直接读子向量的，第二个元素会读到未初始化内存，例如 {a=NULL, b=497}。
# 这是 duckfn 读取路径的既有问题，与 MAP 无关，LIST 上同样能复现：
#   SELECT dfn_echo_list_integer_n([NULL, NULL]);   -- 会得到 [NULL, 713]
query T
SELECT CAST(dfn_echo_map_varchar_integer_n(map(['a', 'b'], [NULL::INTEGER, NULL::INTEGER])) AS VARCHAR);
----
{a=NULL, b=NULL}

query T
SELECT CAST((dfn_echo_map_varchar_integer_n(map(['a', 'b'], [1, NULL])))['b'] IS NULL AS VARCHAR);
----
true

# NULL 行 + 可空 value 混合
query T
SELECT CAST(dfn_echo_map_varchar_integer_n(i) AS VARCHAR) FROM (VALUES
    (map(['a'], [1])),
    (NULL::MAP(VARCHAR, INTEGER)),
    (map(['b', 'c'], [NULL, 3]))
) t(i);
----
{a=1}
NULL
{b=NULL, c=3}

# ============================================================================
# MAP(INTEGER, VARCHAR) // IndexMap<i32, Option<String>>，value 可为 NULL
# ============================================================================

query T
SELECT typeof(dfn_echo_map_integer_varchar_n(map([1], ['a'])));
----
MAP(INTEGER, VARCHAR)

query T
SELECT CAST(dfn_echo_map_integer_varchar_n(
    map([1, 2, 3], ['a', NULL, ''])
) AS VARCHAR);
----
{1=a, 2=NULL, 3=''}

# ============================================================================
# MAP(VARCHAR, DATE) // IndexMap<String, Option<DuckDate>>，value 可为 NULL
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_date_n(map(['d'], [NULL::DATE])));
----
MAP(VARCHAR, DATE)

query T
SELECT CAST(dfn_echo_map_varchar_date_n(
    map(['d1', 'd2'], [DATE '2024-01-02', NULL::DATE])
) AS VARCHAR);
----
{d1=2024-01-02, d2=NULL}

# ============================================================================
# MAP(VARCHAR, DECIMAL(18,3)) // IndexMap<String, Option<DuckDecimal<18, 3>>>
# ============================================================================

query T
SELECT typeof(dfn_echo_map_varchar_decimal_n(map(['d'], [NULL::DECIMAL(18,3)])));
----
MAP(VARCHAR, DECIMAL(18,3))

query T
SELECT CAST(dfn_echo_map_varchar_decimal_n(
    map(['d1', 'd2'], [1.234::DECIMAL(18,3), NULL::DECIMAL(18,3)])
) AS VARCHAR);
----
{d1=1.234, d2=NULL}

# ============================================================================
# MAP(VARCHAR, MAP(VARCHAR, INTEGER))
# // IndexMap<String, Option<IndexMap<String, Option<i32>>>>，嵌套 MAP 且各层 value 可为 NULL
# ============================================================================

query T
SELECT typeof(dfn_echo_map_nested_n(map(['o'], [map(['i'], [1])])));
----
MAP(VARCHAR, MAP(VARCHAR, INTEGER))

query T
SELECT CAST(dfn_echo_map_nested_n(
    map(['o1', 'o2'], [map(['a', 'b'], [1, NULL]), NULL::MAP(VARCHAR, INTEGER)])
) AS VARCHAR);
----
{o1={a=1, b=NULL}, o2=NULL}

# 外层为 NULL value 时内层不受影响
query T
SELECT CAST(dfn_echo_map_nested_n(map(['o'], [NULL::MAP(VARCHAR, INTEGER)]))['o'] IS NULL AS VARCHAR);
----
true

# ============================================================================
# 空 MAP
# ============================================================================

query T
SELECT CAST(dfn_echo_map_varchar_integer(map([]::VARCHAR[], []::INTEGER[])) AS VARCHAR);
----
{}

query T
SELECT CAST(dfn_echo_map_varchar_integer_n(map([]::VARCHAR[], []::INTEGER[])) AS VARCHAR);
----
{}

query T
SELECT CAST(cardinality(dfn_echo_map_varchar_integer(map([]::VARCHAR[], []::INTEGER[]))) AS VARCHAR);
----
0

# ============================================================================
# 批量：1000 行，每行 2 个 entry，验证 ListVector::reserve/set_size 的子向量容量
# ============================================================================

query T
SELECT CAST(sum(cardinality(a)) AS VARCHAR) FROM (
    SELECT dfn_echo_map_varchar_integer(map(['a', 'b'], [1, 2])) AS a FROM range(1000)
) t;
----
2000

query T
SELECT CAST(sum(kv) AS VARCHAR) FROM (
    SELECT unnest(map_values(dfn_echo_map_varchar_integer(map(['a', 'b'], [10, 20])))) AS kv
    FROM range(1000)
) t;
----
30000

# 单个 MAP 塞 100 个 entry
query T
SELECT CAST(cardinality(dfn_echo_map_varchar_integer(map(list(i::VARCHAR), list(i)))) AS VARCHAR)
FROM (SELECT range AS i FROM range(100)) t;
----
100

# 求和与 key 顺序无关，避免依赖 list() 聚合的行序
query T
SELECT CAST(sum(idx) AS VARCHAR) FROM (
    SELECT unnest(
        map_values(dfn_echo_map_varchar_integer(map(list(i::VARCHAR), list(i))))
    ) AS idx
    FROM (SELECT range AS i FROM range(100)) t
) s;
----
4950

# ============================================================================
# 常量向量边界（机理详见 duck_list_scalar_echo.test 中同名小节）
#
# map(['a', 'b'], [NULL, NULL]) 的 value 列表元素类型是未定型的 SQLNULL，
# DuckDB 会给它挂一个"单元素常量 NULL 子向量"，duckfn 按下标裸读会从第 2 个
# entry 起读到未初始化内存（每次运行值不同）：
#   SELECT dfn_echo_map_varchar_integer_n(map(['a', 'b'], [NULL, NULL]));
#   -- 实得 {a=NULL, b=631}
# 下面用等价的显式类型写法固化语义。
# ============================================================================

# entry 的 value 都相同：与全 NULL 无关，安全
query T
SELECT CAST(dfn_echo_map_varchar_integer_n(map(['a', 'b', 'c'], [1, 1, 1])) AS VARCHAR);
----
{a=1, b=1, c=1}

# 只有 1 个 entry 时，value 是未定型 NULL 也安全（只读下标 0）
query T
SELECT CAST(dfn_echo_map_varchar_integer_n(map(['a'], [NULL])) AS VARCHAR);
----
{a=NULL}

# value 列表里混有具体类型时安全
query T
SELECT CAST(dfn_echo_map_varchar_integer_n(map(['a', 'b'], [NULL, 1])) AS VARCHAR);
----
{a=NULL, b=1}

# ============================================================================
# NULL 处理：任何参数为 NULL 时结果应为 NULL
# ============================================================================

query T
SELECT CAST(dfn_echo_map_varchar_integer(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_integer_varchar(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_bigint_bigint(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_integer_double(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_varchar_date(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_varchar_decimal(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_varchar_blob(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_nested(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_varchar_integer_n(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_integer_varchar_n(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_varchar_date_n(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_varchar_decimal_n(NULL) AS VARCHAR)
UNION ALL SELECT CAST(dfn_echo_map_nested_n(NULL) AS VARCHAR);
----
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
NULL
