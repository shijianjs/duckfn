# name: test/sql/types/duck_struct_table_echo.test
# description: duck_struct_table_echo.rs 中 STRUCT 类型（#[derive(DuckStruct)]）的表函数回显测试
# group: [types]

require rusty_quack

# 与标量版本（duck_struct_scalar_echo.test）的差别，正是这个文件存在的意义：
#   - 标量函数按行读父向量的 children。参数被折成常量向量时 child 只有 1 个物理元素，
#     会踩到 duckdb#25616，所以标量用例里到处是 i%8=0 的空转；
#   - 表函数的参数在 bind 阶段从 Value 读（value.struct_child），不按下标访问子向量，
#     因此这里可以直接用单行 struct 字面量，覆盖标量用例覆盖不到的部分。
#
# 出参侧：s_write_columns_batch 逐行写字段，s_write_null 需要递归把子字段一并置 NULL；
# 一批里混着「有值 / NULL」行时（count 奇偶行规则）正好覆盖这条路径。
#
# 另：STRUCT 里带 ARRAY 字段的 dfn_table_echo_struct_with_array，入参换成同形 LIST 版结构，
# 因为 ARRAY 不能作为表函数参数。

statement ok
SET TimeZone='UTC';

# ============================================================================
# STRUCT(id INTEGER, name VARCHAR) // DuckStructSimple
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_simple({'id': 1, 'name': 'a'}, count => 2);
----
{'id': 1, 'name': a}
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_simple({'id': 1, 'name': 'a'});
----
STRUCT(id INTEGER, "name" VARCHAR)

# 顶层整体为 NULL
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_simple(NULL, count => 2);
----
NULL
NULL

# 取子字段：NULL 行上取子字段也是 NULL（s_write_null 递归置 NULL）
query TT
SELECT CAST(v.id AS VARCHAR), CAST(v.name AS VARCHAR)
FROM dfn_table_echo_struct_simple({'id': 1, 'name': 'a'}, count => 2) t(v);
----
1	a
NULL	NULL

# 非 Option 字段读到 NULL：bind 阶段直接失败
statement error
SELECT v FROM dfn_table_echo_struct_simple({'id': 1, 'name': NULL::VARCHAR});
----
Parameter name cannot be null

statement error
SELECT v FROM dfn_table_echo_struct_simple({'id': NULL::INTEGER, 'name': 'a'});
----
Parameter id cannot be null

# ============================================================================
# STRUCT(b BOOLEAN, t TINYINT, s SMALLINT, i INTEGER, l BIGINT, f FLOAT, d DOUBLE, v VARCHAR)
# // DuckStructSimpleTypes
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_simple_types(
    {'b': true, 't': 1::TINYINT, 's': 2::SMALLINT, 'i': 3::INTEGER,
     'l': 4::BIGINT, 'f': 1.5::FLOAT, 'd': 2.5::DOUBLE, 'v': 'x'}, count => 2);
----
{'b': true, 't': 1, 's': 2, 'i': 3, 'l': 4, 'f': 1.5, 'd': 2.5, 'v': x}
NULL

# ============================================================================
# STRUCT(d DATE, ts TIMESTAMP, dec DECIMAL(18,3), bl BLOB) // DuckStructWrapper
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_wrapper(
    {'d': DATE '2024-01-02', 'ts': TIMESTAMP '2024-01-02 03:04:05',
     'dec': 1.234::DECIMAL(18,3), 'bl': '\xAA\xBB'::BLOB}, count => 2);
----
{'d': 2024-01-02, 'ts': '2024-01-02 03:04:05', 'dec': 1.234, 'bl': \xAA\xBB}
NULL

# ============================================================================
# STRUCT(id INTEGER, age INTEGER, name VARCHAR) // DuckStructNullable
# 非 Option 的 id 必填，Option 的 age / name 可为 NULL
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_nullable(
    {'id': 1, 'age': NULL::INTEGER, 'name': NULL::VARCHAR}, count => 2);
----
{'id': 1, 'age': NULL, 'name': NULL}
NULL

# ============================================================================
# STRUCT(id INTEGER, name VARCHAR, data INTEGER[]) // DuckStructAllNullable
# 三个字段都可空
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_all_nullable(
    {'id': NULL::INTEGER, 'name': NULL::VARCHAR, 'data': NULL::INTEGER[]}, count => 2);
----
{'id': NULL, 'name': NULL, 'data': NULL}
NULL

# ============================================================================
# STRUCT(id INTEGER, data INTEGER[], tags VARCHAR[]) // DuckStructWithList
# 子字段是变长 LIST，长度要等写完才确认（依赖 write_finish 递归）
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_with_list(
    {'id': 1, 'data': [1, 2, 3], 'tags': ['a', 'b']}, count => 2);
----
{'id': 1, 'data': [1, 2, 3], 'tags': [a, b]}
NULL

# 空列表
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_with_list(
    {'id': 1, 'data': []::INTEGER[], 'tags': []::VARCHAR[]}, count => 1);
----
{'id': 1, 'data': [], 'tags': []}

# data / tags 是非 Option 字段，整体为 NULL 会 bind 失败
statement error
SELECT v FROM dfn_table_echo_struct_with_list({'id': 1, 'data': NULL::INTEGER[], 'tags': NULL::VARCHAR[]});
----
Parameter data cannot be null

# ============================================================================
# STRUCT(id INTEGER, data INTEGER[]) // DuckStructWithListN
# 列表整体可空、列表元素也可空
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_with_list_n(
    {'id': 1, 'data': [1, NULL, 3]}, count => 2);
----
{'id': 1, 'data': [1, NULL, 3]}
NULL

# ============================================================================
# STRUCT(id INTEGER, m MAP(VARCHAR, INTEGER)) // DuckStructWithMap
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_with_map(
    {'id': 1, 'm': map(['a', 'b'], [1, 2])}, count => 2);
----
{'id': 1, 'm': {a=1, b=2}}
NULL

# ============================================================================
# STRUCT(id INTEGER, arr INTEGER[3]) // DuckStructWithArray
# 入参是同形的 LIST 版结构，由 to_array 定长校验后写成 ARRAY 出参
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_with_array({'id': 1, 'arr': [1, 2, 3]}, count => 2);
----
{'id': 1, 'arr': [1, 2, 3]}
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_with_array({'id': 1, 'arr': [1, 2, 3]});
----
STRUCT(id INTEGER, arr INTEGER[3])

statement error
SELECT v FROM dfn_table_echo_struct_with_array({'id': 1, 'arr': [1, 2]});
----
dfn_table_echo_struct_with_array: expected 3 elements, got 2

statement error
SELECT v FROM dfn_table_echo_struct_with_array({'id': 1, 'arr': [1, 2, 3, 4]});
----
dfn_table_echo_struct_with_array: expected 3 elements, got 4

# 非 Option 的 arr 字段为 NULL
statement error
SELECT v FROM dfn_table_echo_struct_with_array({'id': 1, 'arr': NULL::INTEGER[]});
----
Parameter arr cannot be null

# ============================================================================
# STRUCT(id INTEGER, inner STRUCT(...), maybe STRUCT(...)) // DuckStructNested
# inner 不可空、maybe 可空
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_nested(
    {'id': 1, 'inner': {'key': 'a', 'value': 2}, 'maybe': NULL::STRUCT(key VARCHAR, value INTEGER)},
    count => 2);
----
{'id': 1, 'inner': {'key': a, 'value': 2}, 'maybe': NULL}
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_nested(
    {'id': 1, 'inner': {'key': 'a', 'value': 2}, 'maybe': NULL::STRUCT(key VARCHAR, value INTEGER)});
----
STRUCT(id INTEGER, "inner" STRUCT("key" VARCHAR, "value" INTEGER), maybe STRUCT("key" VARCHAR, "value" INTEGER))

# 内层 struct 有值时
query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_nested(
    {'id': 1, 'inner': {'key': 'a', 'value': 2},
     'maybe': {'key': 'b', 'value': 3}}, count => 1);
----
{'id': 1, 'inner': {'key': a, 'value': 2}, 'maybe': {'key': b, 'value': 3}}

# ============================================================================
# STRUCT(key VARCHAR, value INTEGER) // DuckStructInner
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_inner({'key': 'a', 'value': 2}, count => 2);
----
{'key': a, 'value': 2}
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_inner({'key': 'a', 'value': 2});
----
STRUCT("key" VARCHAR, "value" INTEGER)

# ============================================================================
# STRUCT(id INTEGER, inner STRUCT(...)) // DuckStructNestedOnly
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_nested_only(
    {'id': 1, 'inner': {'key': 'a', 'value': 2}}, count => 2);
----
{'id': 1, 'inner': {'key': a, 'value': 2}}
NULL

# ============================================================================
# LIST(STRUCT(id INTEGER, name VARCHAR)) // Vec<DuckStructSimple>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_list(
    [{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}], count => 2);
----
[{'id': 1, 'name': a}, {'id': 2, 'name': b}]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_list([{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}]);
----
STRUCT(id INTEGER, "name" VARCHAR)[]

# ============================================================================
# LIST(STRUCT(...))，元素可空 // Vec<Option<DuckStructSimple>>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_list_nullable(
    [{'id': 1, 'name': 'a'}, NULL::STRUCT(id INTEGER, name VARCHAR)], count => 2);
----
[{'id': 1, 'name': a}, NULL]
NULL

# ============================================================================
# MAP(VARCHAR, STRUCT(id INTEGER, name VARCHAR)) // IndexMap<String, DuckStructSimple>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_map_value(
    map(['k'], [{'id': 1, 'name': 'a'}]), count => 2);
----
{k={'id': 1, 'name': a}}
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_map_value(map(['k'], [{'id': 1, 'name': 'a'}]));
----
MAP(VARCHAR, STRUCT(id INTEGER, "name" VARCHAR))

# ============================================================================
# MAP(VARCHAR, STRUCT(...))，value 可空 // IndexMap<String, Option<DuckStructSimple>>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_map_value_nullable(
    map(['k'], [NULL::STRUCT(id INTEGER, name VARCHAR)]), count => 2);
----
{k=NULL}
NULL

# ============================================================================
# ARRAY(STRUCT(id INTEGER, name VARCHAR), 2) // DuckArray<DuckStructSimple, 2>
# 入参是对应的 LIST，长度必须正好 2
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_array(
    [{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}], count => 2);
----
[{'id': 1, 'name': a}, {'id': 2, 'name': b}]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_array(
    [{'id': 1, 'name': 'a'}, {'id': 2, 'name': 'b'}]);
----
STRUCT(id INTEGER, "name" VARCHAR)[2]

statement error
SELECT v FROM dfn_table_echo_struct_array([{'id': 1, 'name': 'a'}]);
----
dfn_table_echo_struct_array: expected 2 elements, got 1

# ============================================================================
# ARRAY(STRUCT(...), 2)，元素可空 // DuckOptionArray<DuckStructSimple, 2>
# ============================================================================

query T
SELECT CAST(v AS VARCHAR) FROM dfn_table_echo_struct_array_nullable(
    [{'id': 1, 'name': 'a'}, NULL::STRUCT(id INTEGER, name VARCHAR)], count => 2);
----
[{'id': 1, 'name': a}, NULL]
NULL

query T
SELECT typeof(v) FROM dfn_table_echo_struct_array_nullable(
    [{'id': 1, 'name': 'a'}, NULL::STRUCT(id INTEGER, name VARCHAR)]);
----
STRUCT(id INTEGER, "name" VARCHAR)[2]

statement error
SELECT v FROM dfn_table_echo_struct_array_nullable([{'id': 1, 'name': 'a'}]);
----
dfn_table_echo_struct_array_nullable: expected 2 elements, got 1

# ============================================================================
# 跨 chunk：STRUCT 出参逐行写字段，2048 行之后子字段偏移必须仍然对齐
# ============================================================================

query TT
SELECT CAST(count(*) AS VARCHAR), CAST(count(v) AS VARCHAR)
FROM dfn_table_echo_struct_simple({'id': 1, 'name': 'a'}, count => 3000);
----
3000	1500

query T
SELECT CAST(sum(v.id) AS VARCHAR)
FROM dfn_table_echo_struct_simple({'id': 1, 'name': 'a'}, count => 1000);
----
500
