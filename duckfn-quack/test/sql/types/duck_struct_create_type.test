# name: duckfn-quack/test/sql/types/duck_struct_create_type.test
# description: #[derive(DuckStruct)] 的 create_type：加载期建命名 STRUCT 类型（字段类型含 ENUM / DECIMAL / LIST / ARRAY / MAP / 嵌套 STRUCT，由逻辑类型渲染），以及 "print" 模式只打印不建类型
# group: [types]

require duckfn_quack

# create_type = true 时，扩展加载期执行
#   CREATE TYPE IF NOT EXISTS "ticket" AS
#     STRUCT("id" BIGINT, "priority" ENUM('low', 'medium', 'high'), "labels" VARCHAR[],
#            "slot" INTEGER[3], "scores" MAP(VARCHAR, DOUBLE), "amount" DECIMAL(18,3),
#            "inner" STRUCT("flag" BOOLEAN));
#
# 字段类型不是手写的 SQL，而是注册时把结构体的**逻辑类型**递归渲染出来的：
#   duckdb_get_type_id + 子类型 / 字典 / 精度查询。
# 所以 #[derive(DuckEnum)] 生成的枚举、手写的自定义类型、嵌套结构体、LIST / ARRAY / MAP
# 都会自动带上，Option<T> 的可空性也不影响类型文本。

query I
SELECT count(*) FROM duckdb_types() WHERE type_name = 'ticket';
----
1

# 只有写了 create_type 的才建类型
query I
SELECT count(*) FROM duckdb_types() WHERE type_name IN ('ticket', 'duck_struct_simple');
----
1

# 渲染出来的形状：DuckDB 自己的 typeof 也是这个形状（字段名一律带引号）
query T
SELECT typeof(NULL::ticket);
----
STRUCT(id BIGINT, priority ENUM('low', 'medium', 'high'), labels VARCHAR[], slot INTEGER[3], scores MAP(VARCHAR, DOUBLE), amount DECIMAL(18,3), "inner" STRUCT(flag BOOLEAN))

# 命名类型可以直接作为列类型
statement ok
CREATE TABLE tickets (v ticket);

statement ok
INSERT INTO tickets VALUES ({'id': 1, 'priority': 'low', 'labels': ['a', 'b'], 'slot': [1, 2, 3],
    'scores': MAP{'x': 1.5}, 'amount': 1.234, 'inner': {'flag': true}});

query T
SELECT CAST(v.id AS VARCHAR) FROM tickets;
----
1

# 枚举字段（来自 #[derive(DuckEnum)] 的 Priority，标签是小写）
query T
SELECT CAST(v.priority AS VARCHAR) FROM tickets;
----
low

# LIST 字段
query T
SELECT CAST(v.labels[2] AS VARCHAR) FROM tickets;
----
b

# ARRAY(T, 3) 字段
query T
SELECT CAST(v.slot[2] AS VARCHAR) FROM tickets;
----
2

# MAP 字段
query T
SELECT CAST(v.scores['x'] AS VARCHAR) FROM tickets;
----
1.5

# DECIMAL(18,3) 字段
query T
SELECT CAST(v.amount AS VARCHAR) FROM tickets;
----
1.234

# 嵌套 STRUCT 字段
query T
SELECT CAST(v.inner.flag AS VARCHAR) FROM tickets;
----
true

# 函数（参数是匿名的 STRUCT(...) 类型）可以直接接收命名类型的值
query T
SELECT CAST(e.v.priority AS VARCHAR) FROM (SELECT dfn_echo_struct_ticket(v) AS v FROM tickets) e;
----
low

# 整行为 NULL 时语义与匿名类型一致
query T
SELECT CAST((dfn_echo_struct_ticket(NULL::ticket)).priority AS VARCHAR);
----
NULL

# 命名类型与函数注册用的匿名类型结构相同，可以互相 cast
query T
SELECT CAST(v::ticket AS VARCHAR) IS NOT NULL FROM tickets;
----
true

# ============================================================================
# create_type = "print"：加载期只打印 DDL，不建类型
#
# 打印的是与 create_type = true 完全相同的那条语句：
#   CREATE TYPE IF NOT EXISTS "preview_ticket" AS
#     STRUCT("id" BIGINT, "name" VARCHAR);
# 只是不执行 —— 所以 catalog 里查不到 preview_ticket。
# ============================================================================

query I
SELECT count(*) FROM duckdb_types() WHERE type_name = 'preview_ticket';
----
0

# 对照：真正的 create_type = true 会建出类型
query I
SELECT count(*) FROM duckdb_types() WHERE type_name = 'ticket';
----
1

# 打印模式不影响结构体作为 STRUCT 值类型（匿名 STRUCT(...)）使用
#（`name` 是关键字，DuckDB 渲染 typeof 时会给它加引号）
query T
SELECT typeof(dfn_echo_struct_preview_ticket({'id': 1, 'name': 'a'}));
----
STRUCT(id BIGINT, "name" VARCHAR)

query T
SELECT CAST((dfn_echo_struct_preview_ticket({'id': 1, 'name': 'a'})).name AS VARCHAR);
----
a
