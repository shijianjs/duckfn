# ============================================================================
# FLOAT (f32)
# ============================================================================

query R
SELECT dfn_echo_float(i) FROM (VALUES
    (1.5::FLOAT), (-2.25::FLOAT), (0.0::FLOAT)
) t(i);
----
1.5
-2.25
0.0

query T
SELECT typeof(dfn_echo_float(1.5::FLOAT));
----
FLOAT

# ============================================================================
# DOUBLE (f64)
# ============================================================================

query R
SELECT dfn_echo_double(i) FROM (VALUES
    (1.5::DOUBLE), (-2.25::DOUBLE), (0.0::DOUBLE)
) t(i);
----
1.5
-2.25
0.0

query T
SELECT typeof(dfn_echo_double(1.5::DOUBLE));
----
DOUBLE

# ============================================================================
# VARCHAR (String)
# ============================================================================

query T
SELECT dfn_echo_varchar(i) FROM (VALUES ('abc'), (''), ('你好 🦆')) t(i);
----
abc
(empty)
你好 🦆

query T
SELECT typeof(dfn_echo_varchar('abc'));
----
VARCHAR

# ============================================================================
# NULL 处理：任何参数为 NULL 时结果应为 NULL
# ============================================================================

query R
SELECT dfn_echo_bool(NULL);
----
NULL

query I
SELECT dfn_echo_bigint(NULL);
----
NULL

query R
SELECT dfn_echo_double(NULL);
----
NULL

query T
SELECT dfn_echo_varchar(NULL);
----
NULL
