# name: duckfn-quack/test/sql/types/simple_types_scalar_echo.test
# description: simple_types.rs 中简单类型的 echo 往返测试
# group: [types]

require duckfn_quack

# ============================================================================
# BOOLEAN (bool)
# ============================================================================

query R
SELECT dfn_echo_bool(i) from values (true),(false) t(i);
----
true
false

query T
SELECT typeof(dfn_echo_bool(true));
----
BOOLEAN

# ============================================================================
# TINYINT (i8)
# ============================================================================

query I
SELECT dfn_echo_tinyint(i) FROM (VALUES
    (1::TINYINT), ((-1)::TINYINT), (127::TINYINT), ((-128)::TINYINT)
) t(i);
----
1
-1
127
-128

query T
SELECT typeof(dfn_echo_tinyint(1::TINYINT));
----
TINYINT

# ============================================================================
# SMALLINT (i16)
# ============================================================================

query I
SELECT dfn_echo_smallint(i) FROM (VALUES
    (1::SMALLINT), ((-1)::SMALLINT), (32767::SMALLINT), ((-32768)::SMALLINT)
) t(i);
----
1
-1
32767
-32768

query T
SELECT typeof(dfn_echo_smallint(1::SMALLINT));
----
SMALLINT

# ============================================================================
# INTEGER (i32)
# ============================================================================

query I
SELECT dfn_echo_integer(i) FROM (VALUES
    (1::INTEGER), ((-1)::INTEGER), (2147483647::INTEGER), ((-2147483648)::INTEGER)
) t(i);
----
1
-1
2147483647
-2147483648

query T
SELECT typeof(dfn_echo_integer(1::INTEGER));
----
INTEGER

# ============================================================================
# BIGINT (i64)
# ============================================================================

query I
SELECT dfn_echo_bigint(i) FROM (VALUES
    (1::BIGINT), ((-1)::BIGINT),
    (9223372036854775807::BIGINT), ((-9223372036854775808)::BIGINT)
) t(i);
----
1
-1
9223372036854775807
-9223372036854775808

query T
SELECT typeof(dfn_echo_bigint(1::BIGINT));
----
BIGINT

# ============================================================================
# HUGEINT (i128)
# ============================================================================

query T
SELECT dfn_echo_hugeint(i) FROM (VALUES
    (1::HUGEINT), ((-1)::HUGEINT),
    (170141183460469231731687303715884105727::HUGEINT),
    ((-170141183460469231731687303715884105727)::HUGEINT)
) t(i);
----
1
-1
170141183460469231731687303715884105727
-170141183460469231731687303715884105727

query T
SELECT typeof(dfn_echo_hugeint(1::HUGEINT));
----
HUGEINT

# ============================================================================
# UTINYINT (u8)
# ============================================================================

query I
SELECT dfn_echo_utinyint(i) FROM (VALUES
    (0::UTINYINT), (1::UTINYINT), (255::UTINYINT)
) t(i);
----
0
1
255

query T
SELECT typeof(dfn_echo_utinyint(1::UTINYINT));
----
UTINYINT

# ============================================================================
# USMALLINT (u16)
# ============================================================================

query I
SELECT dfn_echo_usmallint(i) FROM (VALUES
    (0::USMALLINT), (1::USMALLINT), (65535::USMALLINT)
) t(i);
----
0
1
65535

query T
SELECT typeof(dfn_echo_usmallint(1::USMALLINT));
----
USMALLINT

# ============================================================================
# UINTEGER (u32)
# ============================================================================

query T
SELECT dfn_echo_uinteger(i) FROM (VALUES
    (0::UINTEGER), (1::UINTEGER), (4294967295::UINTEGER)
) t(i);
----
0
1
4294967295

query T
SELECT typeof(dfn_echo_uinteger(1::UINTEGER));
----
UINTEGER

# ============================================================================
# UBIGINT (u64)
# ============================================================================

query T
SELECT dfn_echo_ubigint(i) FROM (VALUES
    (0::UBIGINT), (1::UBIGINT), (18446744073709551615::UBIGINT)
) t(i);
----
0
1
18446744073709551615

query T
SELECT typeof(dfn_echo_ubigint(1::UBIGINT));
----
UBIGINT

# ============================================================================
# UHUGEINT (u128)
# ============================================================================

query T
SELECT dfn_echo_uhugeint(i) FROM (VALUES
    (0::UHUGEINT), (1::UHUGEINT),
    (340282366920938463463374607431768211455::UHUGEINT)
) t(i);
----
0
1
340282366920938463463374607431768211455

query T
SELECT typeof(dfn_echo_uhugeint(1::UHUGEINT));
