# name: duckfn-quack/test/sql/types/duck_opt_option_scalar_echo.test
# description: duck_opt_option_scalar_echo.rs 中 Option<Option<T>> 与 Option<T> 等价的标量 echo 测试
# group: [types]

require duckfn_quack

# 双层 Option 是有意保留的能力：封装层有时不方便把中间类型剥出来（泛型参数本身可能
# 已经是 Option），直接再套一层 Option 就能表达「可空」，不必为「本来就是 Option」
# 的情况单独加分支。
#
# 等价性的依据是 src/value_types/duck_option.rs：
#   - logical_type 逐层转发给最内层类型：Option<Option<i32>> 与 i32 都是 INTEGER，
#     DuckDB 的逻辑类型里没有「可空」这一维，套几层都一样；
#   - 读：NULL 槽位由 read() 在外层判掉，读不出 Some(None)，只会得到最外层 None；
#   - 写：None 与 Some(None) 都落到 T::write_null，都是写 NULL。
# 因此 Option<Option<T>> 在 SQL 层面与 Option<T> 完全等价，本文件逐条固化这一点。

# ============================================================================
# INTEGER // Option<Option<i32>>
# ============================================================================

query I
SELECT dfn_echo_opt_option_integer(42);
----
42

# 外层 None 就是 SQL NULL：双层也能接住 NULL
query I
SELECT dfn_echo_opt_option_integer(NULL);
----
NULL

# 类型就是最内层类型，不会因为多套一层而改变
query T
SELECT typeof(dfn_echo_opt_option_integer(42));
----
INTEGER

# 按行混着 NULL：某行是 NULL 不影响其它行
query I
SELECT dfn_echo_opt_option_integer(i) FROM (VALUES (1), (NULL), (3)) t(i);
----
1
NULL
3

# 与单层对比并排跑：逐行一致（左侧是 simple_types 的 i32 echo，入参写 T）
query II
SELECT dfn_echo_integer(i), dfn_echo_opt_option_integer(i) FROM (VALUES (1), (NULL), (3)) t(i);
----
1	1
NULL	NULL
3	3

# ============================================================================
# VARCHAR // Option<Option<String>>
# ============================================================================

# 空串是「有值」，不是 NULL —— NULL 只有一层表达
query T
SELECT dfn_echo_opt_option_varchar(i) FROM (VALUES ('a'), (''), (NULL)) t(i);
----
a
(empty)
NULL

query T
SELECT typeof(dfn_echo_opt_option_varchar('abc'));
----
VARCHAR

# ============================================================================
# DATE // Option<Option<DuckDate>>
# ============================================================================

query T
SELECT CAST(dfn_echo_opt_option_date(i) AS VARCHAR) FROM (VALUES
    (DATE '2024-01-02'),
    (NULL),
    (DATE '1969-12-31')
) t(i);
----
2024-01-02
NULL
1969-12-31

query T
SELECT typeof(dfn_echo_opt_option_date(DATE '2024-01-02'));
----
DATE

# ============================================================================
# LIST(INTEGER) // Option<Option<Vec<Option<i32>>>>
# 外层双层 Option（列表本身可空）+ 内层元素可空，两种可空互不干扰
# ============================================================================

query T
SELECT CAST(dfn_echo_opt_option_list(i) AS VARCHAR) FROM (VALUES
    ([1, NULL, 3]::INTEGER[]),
    (NULL::INTEGER[]),
    ([]::INTEGER[])
) t(i);
----
[1, NULL, 3]
NULL
[]

# 元素类型是 Option<Option<i32>>，NULL 元素原样保留
# （对比 duck_list_scalar_echo.test 里的 Vec<i32>：元素 NULL 会让整个列表变 NULL）
query T
SELECT CAST(dfn_echo_opt_option_list([1, NULL, 3]) AS VARCHAR);
----
[1, NULL, 3]

query T
SELECT typeof(dfn_echo_opt_option_list([1, NULL, 3]));
----
INTEGER[]

# ============================================================================
# STRUCT(v INTEGER, l INTEGER[]) // 字段本身是双层 Option
# ============================================================================

query TT
SELECT CAST(x.v AS VARCHAR), CAST(x.l AS VARCHAR)
FROM (SELECT dfn_echo_opt_option_struct({'v': 5, 'l': [1, NULL, 3]}) AS x);
----
5	[1, NULL, 3]

query TT
SELECT typeof(x.v), typeof(x.l)
FROM (SELECT dfn_echo_opt_option_struct({'v': 5, 'l': [1, NULL, 3]}) AS x);
----
INTEGER	INTEGER[]

# 字段全 NULL：v 与 l 都是 NULL，不会多出「中间态」
query TT
SELECT CAST(x.v AS VARCHAR), CAST(x.l AS VARCHAR)
FROM (SELECT dfn_echo_opt_option_struct({'v': NULL, 'l': NULL}) AS x);
----
NULL	NULL

# ============================================================================
# STRUCT(id INTEGER, name VARCHAR) // Option<Option<DuckStructSimple>>
# ============================================================================

query T
SELECT CAST(dfn_echo_opt_option_struct_simple(x) AS VARCHAR) FROM (VALUES
    ({'id': 1, 'name': 'a'}),
    (NULL::STRUCT(id INTEGER, name VARCHAR))
) t(x);
----
{'id': 1, 'name': a}
NULL

query T
SELECT typeof(dfn_echo_opt_option_struct_simple({'id': 1, 'name': 'a'}));
----
STRUCT(id INTEGER, "name" VARCHAR)
